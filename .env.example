# =================================================================
#  Harare Polytechnic DSpace — Environment Variables
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#    nano .env
# =================================================================

# Server IP / hostname (the address users type in their browser)
SERVER_HOST=192.168.26.3

# Database password (use a strong password!)
DSPACE_DB_PASSWORD=DSpaceHrep2024!

# SMTP email server (use your IT department mail server)
SMTP_HOST=mail.hrepoly.ac.zw

# Handle.net prefix (leave as 123456789 for local testing)
# Register a real prefix at https://www.handle.net/
HANDLE_PREFIX=123456789

# Admin account (set before first run)
DSPACE_ADMIN_EMAIL=library@hrepoly.ac.zw
DSPACE_ADMIN_PASS=Admin@Hrep2024!
