# =================================================================
#  Harare Polytechnic DSpace — Environment Variables
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#    nano .env
# =================================================================

# Public IP / hostname (the address users type in their browser)
SERVER_HOST=repo.example.edu

# Optional short hostname used in some native nginx configs
SERVER_NAME=repository-host

# Public-facing site name
DSPACE_SITE_NAME=Harare Polytechnic Institutional Repository

# Public protocol and UI/API SSL mode
PUBLIC_PROTOCOL=http
DSPACE_UI_SSL=false
DSPACE_REST_SSL=false
DSPACE_REST_PORT=80

# Database password (use a strong password!)
DSPACE_DB_PASSWORD=change-this-database-password

# SMTP email server (use your IT department mail server)
SMTP_HOST=mail.example.edu

# Sender / notification email addresses
SMTP_FROM_ADDRESS=dspace@example.edu
DSPACE_ALERT_EMAIL=alerts@example.edu

# Handle.net prefix (leave as 123456789 for local testing)
# Register a real prefix at https://www.handle.net/
HANDLE_PREFIX=123456789

# Admin account (set before first run)
DSPACE_ADMIN_EMAIL=admin@example.edu
DSPACE_ADMIN_PASS=change-this-admin-password
