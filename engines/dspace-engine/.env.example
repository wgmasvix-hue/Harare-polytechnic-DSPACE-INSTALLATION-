# =============================================================================
#  ChengetAi DSpace Engine — Environment Variables
#  Copy to .env and fill in your values before running install.sh
#
#    cp .env.example .env
#    nano .env
# =============================================================================

# -----------------------------------------------
# PUBLIC-FACING HOSTNAME
# Use a domain name (e.g. repo.university.ac.zw)
# or a public IP address.
# -----------------------------------------------
DSPACE_HOSTNAME=repo.example.ac.zw

# -----------------------------------------------
# REPOSITORY NAME (shown in DSpace UI)
# -----------------------------------------------
DSPACE_NAME=My Institutional Repository

# -----------------------------------------------
# PROTOCOL — http or https
# Set to https after running SSL setup
# -----------------------------------------------
PUBLIC_PROTOCOL=http

# -----------------------------------------------
# DATABASE
# -----------------------------------------------
POSTGRES_PASSWORD=change_me_strong_password

# -----------------------------------------------
# ADMIN ACCOUNT
# Created automatically on first install
# -----------------------------------------------
ADMIN_EMAIL=admin@example.ac.zw
ADMIN_PASSWORD=change_me_admin_password

# -----------------------------------------------
# EMAIL / SMTP
# -----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=25
MAIL_FROM=dspace@example.ac.zw

# -----------------------------------------------
# HANDLE SERVER PREFIX
# Use 123456789 for local testing.
# Register a real prefix at https://www.handle.net/
# -----------------------------------------------
HANDLE_PREFIX=123456789

# -----------------------------------------------
# MEMORY TUNING
# -----------------------------------------------
JAVA_MEMORY=-Xmx2g -Xms512m
SOLR_MEMORY=512m

# -----------------------------------------------
# BACKUP
# -----------------------------------------------
BACKUP_ROOT=/var/backups/chengetai/dspace
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------
# DSpace image tags — do not change unless upgrading
# -----------------------------------------------
DSPACE_BACKEND_TAG=dspace-8_x
DSPACE_FRONTEND_TAG=dspace-8_x
DSPACE_SOLR_TAG=dspace-8_x
