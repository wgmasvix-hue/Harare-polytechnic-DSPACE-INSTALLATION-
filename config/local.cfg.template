# ============================================================
#  DSpace 9 - Harare Polytechnic Configuration Template
#  Copy to: /dspace/config/local.cfg
#  Update all values marked with <CHANGE THIS>
# ============================================================

#------------------------------------------------------------------
# DSpace Installation Location
#------------------------------------------------------------------
dspace.dir = /dspace

#------------------------------------------------------------------
# URLs - Update with your actual hostname/IP
#------------------------------------------------------------------
dspace.server.url = http://192.168.26.3:8080/server
dspace.ui.url = http://192.168.26.3:4000

# Public-facing name shown in the interface
dspace.name = Harare Polytechnic Institutional Repository

dspace.hostname = 192.168.26.3

#------------------------------------------------------------------
# Database
#------------------------------------------------------------------
db.driver = org.postgresql.Driver
db.url = jdbc:postgresql://localhost:5432/dspace
db.username = dspace
db.password = <CHANGE THIS - use strong password>
db.schema = public

# Connection pool
db.maxconnections = 30
db.maxwait = 5000
db.maxidle = 10
db.statementpool = true

#------------------------------------------------------------------
# Solr
#------------------------------------------------------------------
solr.server = http://localhost:8983/solr

#------------------------------------------------------------------
# Email / SMTP
#------------------------------------------------------------------
# If you have a local mail server (postfix/sendmail), use localhost
mail.server = localhost
mail.server.port = 25

# If using Gmail SMTP:
# mail.server = smtp.gmail.com
# mail.server.port = 587
# mail.server.username = your-gmail@gmail.com
# mail.server.password = your-app-password
# mail.extraproperties = mail.smtp.starttls.enable=true

mail.from.address = dspace@hrepoly.ac.zw
mail.feedback.recipient = library@hrepoly.ac.zw
mail.admin = library@hrepoly.ac.zw

# Alert admins of errors
alert.recipient = library@hrepoly.ac.zw

#------------------------------------------------------------------
# Handle Server (digital object identifiers)
# Register at https://www.handle.net/ for a real prefix
#------------------------------------------------------------------
handle.canonical.prefix = http://hdl.handle.net/
handle.prefix = 123456789

#------------------------------------------------------------------
# User Registration
#------------------------------------------------------------------
# Allow self-registration
user.registration = true

# Require email confirmation
authentication-password.domain.valid = hrepoly.ac.zw, gmail.com

#------------------------------------------------------------------
# Language
#------------------------------------------------------------------
default.locale = en

#------------------------------------------------------------------
# File Storage (assetstore)
#------------------------------------------------------------------
assetstore.dir = ${dspace.dir}/assetstore

#------------------------------------------------------------------
# Thumbnails
#------------------------------------------------------------------
thumbnail.maxwidth = 300
thumbnail.maxheight = 300

#------------------------------------------------------------------
# Authority Control
#------------------------------------------------------------------
plugin.named.org.dspace.content.authority.ChoiceAuthority = \
    org.dspace.content.authority.SolrAuthority = SolrAuthorAuthority, \
    org.dspace.content.authority.SolrAuthority = SolrEditorAuthority, \
    org.dspace.content.authority.SolrAuthority = SolrSubjectAuthority

#------------------------------------------------------------------
# Statistics
#------------------------------------------------------------------
# Spider IP ranges to exclude from stats
usage-statistics.dbfile = ${dspace.dir}/config/spiders/
